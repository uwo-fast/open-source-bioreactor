# Untracked build output and scratch
output
working.tmp

# Raw run data. These are measurements, not documents - reformatting them would
# rewrite the record of an experiment to satisfy a style rule.
analysis/runs/*/raw
analysis/.venv

# Hand-aligned by column and marked DO NOT FORMAT in the files themselves
*.csv

# Tool caches
.mypy_cache
.ruff_cache
.pytest_cache
node_modules

# Pinned OpenSCAD libraries - upstream code, not ours to format
.openscad-libraries

# Customizer parameter sets. The OpenSCAD GUI writes these in its own layout on every save;
# json-prune keeps that layout so a save and a prune do not fight over indentation.
scad/*.json
